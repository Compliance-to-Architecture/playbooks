# ============================================================================
# Coding Engine — Environment Variables
# ============================================================================
# Copy this file to .env and fill in values for your environment.
# All variables are optional unless marked REQUIRED.

# ── Core ──────────────────────────────────────────────────────────────────
NODE_ENV=development
ENGINE_PORT=3100                     # HTTP server port (default: 3100)
ENGINE_HOSTNAME=0.0.0.0             # Bind address (default: 0.0.0.0)
ENGINE_REQUIRE_AUTH=true             # Require API key auth (default: true)

# ── GitHub Integration ────────────────────────────────────────────────────
# REQUIRED for failure pipeline GitHub Actions source
GH_TOKEN=                            # GitHub PAT with repo + actions scope
GH_REPOSITORY=owner/repo             # GitHub repository (owner/repo format)

# ── Storage Backend ───────────────────────────────────────────────────────
# Default: file-based storage (no config needed)
# For distributed mode, configure ONE of the following:

# Redis (optional — requires ioredis)
# REDIS_URL=redis://localhost:6379
# REDIS_KEY_PREFIX=coding-engine
# REDIS_DEFAULT_TTL_MS=86400000     # 24 hours

# PostgreSQL (optional — requires pg)
# DATABASE_URL=postgres://user:pass@localhost:5432/coding_engine
# PG_POOL_SIZE=5
# PG_TABLE_NAME=coding_engine_kv

# ── Agent Memory (Hindsight) ─────────────────────────────────────────────
# Optional — enables cross-session semantic memory
# HINDSIGHT_BASE_URL=http://localhost:8888
# HINDSIGHT_BANK_ID=coding-engine
# HINDSIGHT_RECALL_BUDGET=5000      # Max tokens for recall (default: 5000)

# ── Webhook Dispatch ─────────────────────────────────────────────────────
# Optional — configure webhook endpoints for event notifications
# WEBHOOK_ENDPOINT_URL=https://your-app.com/webhooks/engine
# WEBHOOK_SECRET=your-secret-at-least-16-chars
# WEBHOOK_EVENTS=failure.detected,failure.fixed,health.unhealthy

# ── Compliance Engine ────────────────────────────────────────────────────
# COMPLIANCE_STANDARDS=SOC2,GDPR    # Comma-separated standards to enforce
# COMPLIANCE_STRICT=false           # Block on violations (default: false)

# ── Code-Mode (UTCP) ────────────────────────────────────────────────────
# Optional — enables tool execution optimization
# CODE_MODE_ENABLED=false
# CODE_MODE_TIMEOUT_MS=30000

# ── Observability ────────────────────────────────────────────────────────
# LOG_LEVEL=info                    # debug, info, warn, error
# SENTRY_DSN=                       # Sentry error tracking DSN
# AXIOM_API_TOKEN=                  # Axiom analytics token
# AXIOM_ORG_ID=                     # Axiom organization ID

# ── Stripe (Billing) ────────────────────────────────────────────────────
# Optional — for usage metering features
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ── Cloud Providers ──────────────────────────────────────────────────────
# AWS
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-west-1

# Cloudflare
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
